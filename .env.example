# Telegram'da @BotFather tarafından verilen gizli bot tokenı.
TELEGRAM_BOT_TOKEN=

# Yalnızca pozitif sayısal Telegram kullanıcı ID'leri. Birden fazlasını virgülle ayırın.
TELEGRAM_ALLOWED_USER_IDS=

# Bu üç dosya yereldir ve Git tarafından yok sayılır.
PROJECTS_FILE=./config/projects.json
SESSIONS_FILE=./data/sessions.json
DESKTOP_MONITOR_FILE=./data/desktop-monitor.json
DESKTOP_MONITOR_INTERVAL_MS=5000

# Windows'ta Codex Desktop otomatik bulunur. macOS/Linux'ta PATH'teki "codex" kullanılır.
CODEX_BIN=codex

# Boş bırakılırsa Codex'in yapılandırılmış varsayılan modeli kullanılır.
CODEX_MODEL=

# Boşsa Desktop ve Documents taranır. Windows'ta ; macOS/Linux'ta : ile ayırın.
PROJECT_ROOTS=
PROJECT_SCAN_MAX_DEPTH=4
PROJECT_AUTO_ADD_DEPTH=1
